# Canonical environment template.
# Copy to .env in the project root.
# The frontend is built for /xingxing, so keep BASE_PATH=/xingxing unless code is changed too.

NODE_ENV=production
NODE_NO_WARNINGS=1
PATH=/usr/local/bin:/usr/bin:/bin
PORT=3000
HOST=127.0.0.1
BASE_PATH=/xingxing

# Used only when the database has no admin user yet.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-production

# Use a long random value in production.
SESSION_SECRET=replace-with-a-long-random-secret-at-least-24-chars

# Keep production databases empty until you add/import real records.
SEED_SAMPLE_DATA=false

# SQLite file path, relative to the project root when using systemd.
DATABASE_PATH=./data/birthday.sqlite
