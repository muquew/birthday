[Unit]
Description=Xingxing Birthday Site
After=network.target

[Service]
Type=simple
User=xingxing
Group=xingxing
WorkingDirectory=/opt/xingxing-birthday
EnvironmentFile=/opt/xingxing-birthday/.env
ExecStart=/usr/bin/env node dist-server/server/index.js
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/xingxing-birthday/data

[Install]
WantedBy=multi-user.target
